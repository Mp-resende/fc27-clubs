# Clube monitorado
CLUB_ID=682077
CLUB_NAME=MVL ES
PLATFORM=common-gen5

# Banco de dados
DB_PATH=data/fc27_clubs.db

# Backup automatico do historico
BACKUP_DIR=data/backups
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=30

# Servidor web
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Ingestão
INGEST_INTERVAL_SECONDS=300
INGEST_JITTER_SECONDS=30
EA_TIMEOUT_SECONDS=20.0
EA_MAX_ATTEMPTS=4
EA_MIN_REQUEST_INTERVAL_S=1.0

# Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_BACKOFF_SECONDS=1800

# Logs
LOG_LEVEL=INFO
PARSER_VERSION=parser-3.0

# Revisão de resultados e prints da partida
EVIDENCE_DIR=data/evidence
EVIDENCE_MAX_BYTES=10485760
# Extrator multimodal (API compatível com OpenAI). Deixe a chave vazia para
# usar apenas OCR local (extras "ocr") ou correção manual no dashboard.
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
VISION_TIMEOUT_SECONDS=30

